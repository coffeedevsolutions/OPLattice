+/* ------------------------------------------------------------------------- *
+ * Recently played list.
+ *
+ * OPL already records a single `last_played` startup id. This keeps a short
+ * ordered list alongside it, newest first, in the same conf_last.cfg. Titles
+ * are stored with the ids so a header can render them without having to search
+ * the current device's list for a game that may live on another device.
+ * ------------------------------------------------------------------------- */
+
+static char recentStartup[OPL_RECENT_MAX][32];
+static char recentTitle[OPL_RECENT_MAX][64];
+static int recentCount = 0;
+
+int oplRecentCount(void) { return recentCount; }
+const char *oplRecentStartup(int index) { return (index >= 0 && index < recentCount) ? recentStartup[index] : NULL; }
+const char *oplRecentTitle(int index) { return (index >= 0 && index < recentCount) ? recentTitle[index] : NULL; }
+
+int oplRecentRank(const char *startup)
+{
+    int i;
+
+    if (startup != NULL) {
+        for (i = 0; i < recentCount; i++) {
+            if (strcmp(recentStartup[i], startup) == 0)
+                return i;
+        }
+    }
+
+    return OPL_RECENT_MAX;
+}
+
+void oplRecentLoad(void)
+{
+    config_set_t *configLast = configGetByType(CONFIG_LAST);
+    char key[32];
+    const char *value;
+    int i;
+
+    recentCount = 0;
+    for (i = 0; i < OPL_RECENT_MAX; i++) {
+        snprintf(key, sizeof(key), "recent%d_id", i);
+        if (!configGetStr(configLast, key, &value) || value[0] == '\0')
+            break;
+
+        strncpy(recentStartup[recentCount], value, sizeof(recentStartup[0]) - 1);
+        recentStartup[recentCount][sizeof(recentStartup[0]) - 1] = '\0';
+
+        snprintf(key, sizeof(key), "recent%d_title", i);
+        if (configGetStr(configLast, key, &value)) {
+            strncpy(recentTitle[recentCount], value, sizeof(recentTitle[0]) - 1);
+            recentTitle[recentCount][sizeof(recentTitle[0]) - 1] = '\0';
+        } else
+            recentTitle[recentCount][0] = '\0';
+
+        recentCount++;
+    }
+}
+
+void oplRecentPush(const char *startup, const char *title)
+{
+    config_set_t *configLast = configGetByType(CONFIG_LAST);
+    char key[32];
+    int i, existing;
+
+    if (startup == NULL || startup[0] == '\0')
+        return;
+
+    // Move an existing entry to the front rather than duplicating it.
+    existing = oplRecentRank(startup);
+    if (existing >= recentCount)
+        existing = (recentCount < OPL_RECENT_MAX) ? recentCount++ : OPL_RECENT_MAX - 1;
+
+    for (i = existing; i > 0; i--) {
+        memcpy(recentStartup[i], recentStartup[i - 1], sizeof(recentStartup[0]));
+        memcpy(recentTitle[i], recentTitle[i - 1], sizeof(recentTitle[0]));
+    }
+
+    strncpy(recentStartup[0], startup, sizeof(recentStartup[0]) - 1);
+    recentStartup[0][sizeof(recentStartup[0]) - 1] = '\0';
+    if (title != NULL) {
+        strncpy(recentTitle[0], title, sizeof(recentTitle[0]) - 1);
+        recentTitle[0][sizeof(recentTitle[0]) - 1] = '\0';
+    } else
+        recentTitle[0][0] = '\0';
+
+    for (i = 0; i < recentCount; i++) {
+        snprintf(key, sizeof(key), "recent%d_id", i);
+        configSetStr(configLast, key, recentStartup[i]);
+        snprintf(key, sizeof(key), "recent%d_title", i);
+        configSetStr(configLast, key, recentTitle[i]);
+    }
+
+    saveConfig(CONFIG_LAST, 0);
+}
