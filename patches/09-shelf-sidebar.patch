+/** The support driver whose list currently contains this startup id.
+ *
+ * The pending record survives on disc but the device does not: a game launched
+ * from MMCE and returned to with the card absent has nowhere to fold its
+ * minutes back into. Walking the live modules is the only honest way to find
+ * out, and finding nothing is a normal outcome rather than an error.
+ */
+static item_list_t *oplStatsFindSupport(const char *startup)
+{
+    int m, i;
+
+    for (m = 0; m < MODE_COUNT; m++) {
+        item_list_t *support = list_support[m].support;
+
+        if (!support || !support->enabled || !support->itemGetStartup)
+            continue;
+
+        for (i = support->itemGetCount(support) - 1; i >= 0; i--) {
+            char *s = support->itemGetStartup(support, i);
+            if (s && !strcmp(s, startup))
+                return support;
+        }
+    }
+
+    return NULL;
+}
+
+
+/** RTC as whole minutes, for subtraction only.
+ *
+ * The Mechacon clock is BCD (see OSDHistory.c, which does the same conversion)
+ * and reads JST on a Japanese console. No timezone conversion is applied here
+ * on purpose: this value is only ever subtracted from another reading of the
+ * same clock, and a constant offset cancels. JST has no daylight saving, so
+ * there is no discontinuity to trip over either.
+ *
+ * LastPlayed's displayed date does inherit that offset and can therefore be a
+ * day out either side of midnight. That is a known limitation of this minimal
+ * core, to be resolved by the full clock feature which will own the timezone.
+ */
+static int statsNowMinutes(void)
+{
+    sceCdCLOCK clock;
+    int y, m, d, era, yoe, doy, doe, days;
+
+    if (!sceCdReadClock(&clock))
+        return -1;
+
+    y = 2000 + btoi(clock.year);
+    m = btoi(clock.month & 0x7F);
+    d = btoi(clock.day);
+    if (m < 1 || m > 12 || d < 1 || d > 31)
+        return -1;
+
+    /* days_from_civil, Howard Hinnant's algorithm. */
+    y -= (m <= 2);
+    era = (y >= 0 ? y : y - 399) / 400;
+    yoe = y - era * 400;
+    doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+    doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    days = era * 146097 + doe - 719468;
+
+    return days * 1440 + btoi(clock.hour) * 60 + btoi(clock.minute);
+}
+
+/** Longest session we are willing to believe, in minutes.
+ *
+ * A session ended with the power button leaves its pending record on disc, and
+ * the next cold boot computes launch-to-now -- which includes however long the
+ * console sat switched off. There is no way to tell that apart from a genuine
+ * marathon after the fact, so anything past this is discarded rather than
+ * recorded. A missing session is recoverable; a fabricated 40-hour one silently
+ * poisons a total nobody can audit.
+ */
+#define STATS_SESSION_CAP_MINUTES (12 * 60)
+
+void oplStatsOnLaunch(const char *startup, config_set_t *configSet)
+{
+    config_set_t *configLast;
+    char stamp[16];
+    int now, count = 0;
+
+    if (!gEnablePlayStats || !gEnableWrite || startup == NULL || startup[0] == '\0')
+        return;
+
+    now = statsNowMinutes();
+    if (now < 0) {
+        LOG("STATS: RTC unreadable, not recording a launch\n");
+        return;
+    }
+
+    /* Per-game keys. configWrite rewrites the whole in-memory list in order, so
+     * everything already in this file survives untouched. */
+    if (configSet) {
+        sceCdCLOCK clock;
+        char date[16];
+
+        if (sceCdReadClock(&clock)) {
+            snprintf(date, sizeof(date), "%02d-%02d-%04d",
+                     btoi(clock.day), btoi(clock.month & 0x7F), 2000 + btoi(clock.year));
+            configSetStr(configSet, "LastPlayed", date);
+        }
+        configGetInt(configSet, "PlayCount", &count);
+        configSetInt(configSet, "PlayCount", count + 1);
+        configWrite(configSet);
+    }
+
+    /* The pending record has to reach disc before the game takes the machine. */
+    configLast = configGetByType(CONFIG_LAST);
+    snprintf(stamp, sizeof(stamp), "%d", now);
+    configSetStr(configLast, CONFIG_LAST_PENDING_STARTUP, startup);
+    configSetStr(configLast, CONFIG_LAST_PENDING_STAMP, stamp);
+    saveConfig(CONFIG_LAST, 0);
+}
+
+void oplStatsOnReturn(void)
+{
+    config_set_t *configLast, *configSet;
+    const char *startup = NULL;
+    int stamp = 0, now, delta, total = 0;
+    item_list_t *support;
+    base_game_info_t game;
+
+    if (!gEnablePlayStats || !gEnableWrite)
+        return;
+
+    configLast = configGetByType(CONFIG_LAST);
+    if (!configGetStr(configLast, CONFIG_LAST_PENDING_STARTUP, &startup) || !startup || !startup[0])
+        return;
+    configGetInt(configLast, CONFIG_LAST_PENDING_STAMP, &stamp);
+
+    /* Clear it first, whatever happens next. A record that cannot be resolved
+     * must not be retried on every boot. */
+    configRemoveKey(configLast, CONFIG_LAST_PENDING_STARTUP);
+    configRemoveKey(configLast, CONFIG_LAST_PENDING_STAMP);
+    saveConfig(CONFIG_LAST, 0);
+
+    now = statsNowMinutes();
+    if (now < 0 || stamp <= 0)
+        return;
+
+    delta = now - stamp;
+    if (delta <= 0) {
+        LOG("STATS: non-positive session (%d min), discarded\n", delta);
+        return;
+    }
+    if (delta > STATS_SESSION_CAP_MINUTES) {
+        LOG("STATS: %d min exceeds the %d min cap -- probably a power-off, discarded\n",
+            delta, STATS_SESSION_CAP_MINUTES);
+        return;
+    }
+
+    memset(&game, 0, sizeof(game));
+    strncpy(game.startup, startup, GAME_STARTUP_MAX - 1);
+    support = oplStatsFindSupport(startup);
+    if (!support) {
+        LOG("STATS: no device holds %s, %d min lost\n", startup, delta);
+        return;
+    }
+
+    configSet = sbPopulateConfig(&game, support->itemGetPrefix(support), "/");
+    if (!configSet)
+        return;
+
+    configGetInt(configSet, "Playtime", &total);
+    configSetInt(configSet, "Playtime", total + delta);   /* raw minutes */
+    configWrite(configSet);
+    configFree(configSet);
+
+    LOG("STATS: %s +%d min, %d total\n", startup, delta, total + delta);
+}
