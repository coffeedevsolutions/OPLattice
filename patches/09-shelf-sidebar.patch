+static void rmAccountBind(GSTEXTURE *txt)
+{
+    if (!txt)
+        return;
+    vramBoundBytes += gsKit_texture_size(txt->Width, txt->Height, txt->PSM);
+    if (txt->Clut)
+        vramBoundBytes += gsKit_texture_size(16, 16, GS_PSM_CT32);
