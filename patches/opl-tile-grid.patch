+/** Items per row: 1 for a classic list, `columns` for a grid theme. */
+static int menuRowStep(void)
+{
+    items_list_t *list;
+
+    if (!gTheme->itemsList)
+        return 1;
+
+    list = (items_list_t *)gTheme->itemsList->extended;
+    return (list && list->columns > 1) ? list->columns : 1;
+}
+
+static int menuDisplayedItems(void)
+{
+    return ((items_list_t *)gTheme->itemsList->extended)->displayedItems;
+}
+
+/** Move `n` places, clamping at the ends instead of wrapping. */
+static submenu_list_t *menuStepFwd(submenu_list_t *cur, int n)
+{
+    while (n-- > 0 && cur && cur->next)
+        cur = cur->next;
+
+    return cur;
+}
+
+static submenu_list_t *menuStepBack(submenu_list_t *cur, int n)
+{
+    while (n-- > 0 && cur && cur->prev)
+        cur = cur->prev;
+
+    return cur;
+}
+
+/** True when the current selection is still within the visible page. */
+static int menuSelectionOnPage(void)
+{
+    submenu_list_t *cur = selected_item->item->pagestart;
+    int itms = menuDisplayedItems() + 1;
+
+    while (--itms && cur) {
+        if (selected_item->item->current == cur)
+            return 1;
+        cur = cur->next;
+    }
+
+    return 0;
+}
+
