+/** One entry along the row. Only bound in grid themes; see menuHandleInputMain. */
+static void menuNextItem(void)
+{
+    submenu_list_t *cur = selected_item->item->current;
+
+    if (cur && cur->next) {
+        selected_item->item->current = cur->next;
